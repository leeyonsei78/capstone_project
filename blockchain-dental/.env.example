# Sepolia 테스트넷 배포 시 필요 (로컬 테스트는 불필요)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=your_private_key_without_0x_prefix

# ── Oracle Service 설정 ──────────────────────────────────────────
# 병원 데이터 제공자 선택: mock (기본, 테스트용) | hira (실제 HIRA API)
HOSPITAL_PROVIDER=mock

# Oracle 서비스 계정 개인키 (Hardhat Account #3, 로컬 테스트용)
ORACLE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# 로컬 블록체인 RPC
RPC_URL=http://127.0.0.1:8545

# ── HIRA API 설정 (HOSPITAL_PROVIDER=hira 시 필요) ──────────────
# HIRA 개발자 포털: https://www.hira.or.kr/dev
HIRA_API_KEY=발급받은_API_키
HIRA_API_URL=https://apis.data.go.kr/B551182

# ── Slack 알림 서비스 설정 (scripts/slack-notifier.js) ──────────
# Slack 워크스페이스 → Incoming Webhooks 앱에서 채널별로 발급
# 비워두면 콘솔 로그만 출력하고 Slack 전송은 건너뜀
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXXXXXXXXXXXXXXXXXX

# ── AI 사전검토 설정 (scripts/oracle-service.js, application-review-service.js) ──
# OpenAI API 키. insurance_agent/.env의 OPENAI_API_KEY와 동일한 키를 재사용해도 됨
# (같은 GPT-4o 모델을 사용). 없으면 AI 사전검토(참고 의견)를 건너뛰고 기존 규칙
# 기반 동작만 수행함.
# ⚠️ AI는 참고 의견만 생성하며, 실제 승인/거절/지급 등 자금 이동 결정은 절대 내리지 않음
# (그 결정은 기존 오라클 규칙과 관리자 수동 승인이 그대로 담당).
OPENAI_API_KEY=sk-...

# ── 보험증권 자동 발급 설정 (scripts/certificate-service.js) ────
# 증권 PDF가 저장되는 frontend/certificates/를 실제로 서빙하는 base URL.
# 기본값은 frontend 정적 서버(npx serve -l 3000 .)를 그대로 사용.
CERT_BASE_URL=http://localhost:3000/certificates

# ── 사전 알림 기준 (scripts/premium-scheduler.js, maturity-watcher.js) ──
# 납입 기한/만기가 이 시간(초) 이내로 다가오면 Slack으로 1회 사전 알림
REMINDER_SEC=259200
MATURITY_REMINDER_SEC=604800

# ── 준비금 부족 경고 폴링 간격 (scripts/reserve-monitor.js) ─────
# premium-scheduler.js와 POLL_SEC를 공유함 (기본 30초)
POLL_SEC=30
